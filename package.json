{
  "name": "page-pulse-extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "PagePulse（页脉）— 按随机时间周期自动刷新指定页面，让网站保持活跃。",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "icons": "python3 scripts/make-icons.py",
    "pack": "bash scripts/package.sh",
    "check": "npm run validate && npm run test"
  }
}
